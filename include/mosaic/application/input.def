
// =============================================================================
// InputEvent types
// =============================================================================

#ifndef MOSAIC_INPUT_EVENT
#define MOSAIC_INPUT_EVENT(name, base_class, corporeality) 
#endif
    MOSAIC_INPUT_EVENT(InputEvent,            internal::InputEventNoBase, Abstract)
    MOSAIC_INPUT_EVENT(MouseEvent,            InputEvent,                 Abstract)
    MOSAIC_INPUT_EVENT(MouseDownEvent,        MouseEvent,                 Abstract)
    MOSAIC_INPUT_EVENT(MouseUpEvent,          MouseEvent,                 Abstract)
    MOSAIC_INPUT_EVENT(MouseDragEvent,        MouseEvent,                 Abstract)
    MOSAIC_INPUT_EVENT(LeftMouseDownEvent,    MouseDownEvent,             Concrete)
    MOSAIC_INPUT_EVENT(LeftMouseUpEvent,      MouseUpEvent,               Concrete)
    MOSAIC_INPUT_EVENT(LeftMouseDragEvent,    MouseDragEvent,             Concrete)
    MOSAIC_INPUT_EVENT(RightMouseDownEvent,   MouseDownEvent,             Concrete)
    MOSAIC_INPUT_EVENT(RightMouseUpEvent,     MouseUpEvent,               Concrete)
    MOSAIC_INPUT_EVENT(RightMouseDragEvent,   MouseDragEvent,             Concrete)
    MOSAIC_INPUT_EVENT(OtherMouseDownEvent,   MouseDownEvent,             Concrete)
    MOSAIC_INPUT_EVENT(OtherMouseUpEvent,     MouseUpEvent,               Concrete)
    MOSAIC_INPUT_EVENT(OtherMouseDragEvent,   MouseDragEvent,             Concrete)
    MOSAIC_INPUT_EVENT(MouseMoveEvent,        MouseEvent,                 Concrete)
    MOSAIC_INPUT_EVENT(ScrollEvent,           MouseEvent,                 Concrete)
    MOSAIC_INPUT_EVENT(MagnificationEvent,    MouseEvent,                 Concrete)
    MOSAIC_INPUT_EVENT(KeyEvent,              InputEvent,                 Abstract)
    MOSAIC_INPUT_EVENT(KeyDownEvent,          KeyEvent,                   Concrete)
    MOSAIC_INPUT_EVENT(KeyUpEvent,            KeyEvent,                   Concrete)
    MOSAIC_INPUT_EVENT(ModifiersChangedEvent, InputEvent,                 Concrete)
#undef MOSAIC_INPUT_EVENT



// =============================================================================
// Keys, physical and logical
// =============================================================================

#ifndef MOSAIC_INPUT_KEY
#define MOSAIC_INPUT_KEY(key, label)
#endif

MOSAIC_INPUT_KEY(unknown, "Unknown")

// Letter keys. Defined for physical and logical keys
#ifndef MOSAIC_INPUT_KEY_LETTER
#define MOSAIC_INPUT_KEY_LETTER(key, label) MOSAIC_INPUT_KEY(key, label)
#endif
    MOSAIC_INPUT_KEY_LETTER(A, "A")
    MOSAIC_INPUT_KEY_LETTER(S, "S")
    MOSAIC_INPUT_KEY_LETTER(D, "D")
    MOSAIC_INPUT_KEY_LETTER(F, "F")
    MOSAIC_INPUT_KEY_LETTER(H, "H")
    MOSAIC_INPUT_KEY_LETTER(G, "G")
    MOSAIC_INPUT_KEY_LETTER(Z, "Z")
    MOSAIC_INPUT_KEY_LETTER(X, "X")
    MOSAIC_INPUT_KEY_LETTER(C, "C")
    MOSAIC_INPUT_KEY_LETTER(V, "V")
    MOSAIC_INPUT_KEY_LETTER(B, "B")
    MOSAIC_INPUT_KEY_LETTER(Q, "Q")
    MOSAIC_INPUT_KEY_LETTER(W, "W")
    MOSAIC_INPUT_KEY_LETTER(E, "E")
    MOSAIC_INPUT_KEY_LETTER(R, "R")
    MOSAIC_INPUT_KEY_LETTER(Y, "Y")
    MOSAIC_INPUT_KEY_LETTER(T, "T")
    MOSAIC_INPUT_KEY_LETTER(O, "O")
    MOSAIC_INPUT_KEY_LETTER(U, "U")
    MOSAIC_INPUT_KEY_LETTER(I, "I")
    MOSAIC_INPUT_KEY_LETTER(P, "P")
    MOSAIC_INPUT_KEY_LETTER(L, "L")
    MOSAIC_INPUT_KEY_LETTER(J, "J")
    MOSAIC_INPUT_KEY_LETTER(K, "K")
    MOSAIC_INPUT_KEY_LETTER(N, "N")
    MOSAIC_INPUT_KEY_LETTER(M, "M")
#undef MOSAIC_INPUT_KEY_LETTER

// Number row keys. Defined only for physical keys
#ifndef MOSAIC_INPUT_KEY_NUMROW
#if MOSAIC_PHYSICAL_KEYS
#define MOSAIC_INPUT_KEY_NUMROW(key, label) MOSAIC_INPUT_KEY(key, label)
#else
#define MOSAIC_INPUT_KEY_NUMROW(key, label)
#endif
#endif
    MOSAIC_INPUT_KEY_NUMROW(num1, "Num 1")
    MOSAIC_INPUT_KEY_NUMROW(num2, "Num 2")
    MOSAIC_INPUT_KEY_NUMROW(num3, "Num 3")
    MOSAIC_INPUT_KEY_NUMROW(num4, "Num 4")
    MOSAIC_INPUT_KEY_NUMROW(num5, "Num 5")
    MOSAIC_INPUT_KEY_NUMROW(num6, "Num 6")
    MOSAIC_INPUT_KEY_NUMROW(num7, "Num 7")
    MOSAIC_INPUT_KEY_NUMROW(num8, "Num 8")
    MOSAIC_INPUT_KEY_NUMROW(num9, "Num 9")
    MOSAIC_INPUT_KEY_NUMROW(num0, "Num 0")
#undef MOSAIC_INPUT_KEY_NUMROW

// Keypad number keys. Defined only for physical keys
#ifndef MOSAIC_INPUT_KEY_KEYPADNUM
#if MOSAIC_PHYSICAL_KEYS
#define MOSAIC_INPUT_KEY_KEYPADNUM(key, label) MOSAIC_INPUT_KEY(key, label)
#else
#define MOSAIC_INPUT_KEY_KEYPADNUM(key, label)
#endif
#endif
    MOSAIC_INPUT_KEY_KEYPADNUM(keypad1,      "Keypad 1")
    MOSAIC_INPUT_KEY_KEYPADNUM(keypad2,      "Keypad 2")
    MOSAIC_INPUT_KEY_KEYPADNUM(keypad3,      "Keypad 3")
    MOSAIC_INPUT_KEY_KEYPADNUM(keypad4,      "Keypad 4")
    MOSAIC_INPUT_KEY_KEYPADNUM(keypad5,      "Keypad 5")
    MOSAIC_INPUT_KEY_KEYPADNUM(keypad6,      "Keypad 6")
    MOSAIC_INPUT_KEY_KEYPADNUM(keypad7,      "Keypad 7")
    MOSAIC_INPUT_KEY_KEYPADNUM(keypad8,      "Keypad 8")
    MOSAIC_INPUT_KEY_KEYPADNUM(keypad9,      "Keypad 9")
    MOSAIC_INPUT_KEY_KEYPADNUM(keypad0,      "Keypad 0")
    MOSAIC_INPUT_KEY_KEYPADNUM(keypad_enter, "Keypad Enter")
#undef MOSAIC_INPUT_KEY_KEYPADNUM

// Other keypad keys. Defined for physical and logical keys
#ifndef MOSAIC_INPUT_KEY_KEYPAD
#define MOSAIC_INPUT_KEY_KEYPAD(key, label) MOSAIC_INPUT_KEY(key, label)
#endif
    MOSAIC_INPUT_KEY_KEYPAD(keypad_decimal,  "Keypad Decimal")
    MOSAIC_INPUT_KEY_KEYPAD(keypad_multiply, "Keypad Multiply")
    MOSAIC_INPUT_KEY_KEYPAD(keypad_add,      "Keypad Add")
    MOSAIC_INPUT_KEY_KEYPAD(keypad_divide,   "Keypad Divide")
    MOSAIC_INPUT_KEY_KEYPAD(keypad_subtract, "Keypad Subtract")
    MOSAIC_INPUT_KEY_KEYPAD(keypad_equal,    "Keypad Equal")
    MOSAIC_INPUT_KEY_KEYPAD(num_lock,        "Num Lock")
#undef MOSAIC_INPUT_KEY_KEYPAD

// Number keys, number row and keypad. Defined only for logical keys
#ifndef MOSAIC_INPUT_KEY_DIGIT
#if !MOSAIC_PHYSICAL_KEYS
#define MOSAIC_INPUT_KEY_DIGIT(key, label) MOSAIC_INPUT_KEY(key, label)
#else
#define MOSAIC_INPUT_KEY_DIGIT(key, label)
#endif
#endif
    MOSAIC_INPUT_KEY_DIGIT(_1, "1")
    MOSAIC_INPUT_KEY_DIGIT(_2, "2")
    MOSAIC_INPUT_KEY_DIGIT(_3, "3")
    MOSAIC_INPUT_KEY_DIGIT(_4, "4")
    MOSAIC_INPUT_KEY_DIGIT(_5, "5")
    MOSAIC_INPUT_KEY_DIGIT(_6, "6")
    MOSAIC_INPUT_KEY_DIGIT(_7, "7")
    MOSAIC_INPUT_KEY_DIGIT(_8, "8")
    MOSAIC_INPUT_KEY_DIGIT(_9, "9")
    MOSAIC_INPUT_KEY_DIGIT(_0, "0")
#undef MOSAIC_INPUT_KEY_DIGIT

// Symbol keys. Defined for both for physical and logical keys
#ifndef MOSAIC_INPUT_KEY_SYMBOL
#define MOSAIC_INPUT_KEY_SYMBOL(key, label) MOSAIC_INPUT_KEY(key, label)
#endif
    MOSAIC_INPUT_KEY_SYMBOL(equal,              "Equal")
    MOSAIC_INPUT_KEY_SYMBOL(minus,              "Minus")
    MOSAIC_INPUT_KEY_SYMBOL(plus,               "Plus")
    MOSAIC_INPUT_KEY_SYMBOL(right_bracket,      "Right Bracket")
    MOSAIC_INPUT_KEY_SYMBOL(left_bracket,       "Left Bracket")
    MOSAIC_INPUT_KEY_SYMBOL(apostrophe,         "Apostrophe")

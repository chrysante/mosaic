#endif
    MOSAIC_INPUT_KEY_NONCHAR(enter,        "Enter")
    MOSAIC_INPUT_KEY_NONCHAR(tab,          "Tab")
    MOSAIC_INPUT_KEY_NONCHAR(space,        "Space")
    MOSAIC_INPUT_KEY_NONCHAR(backspace,    "Backspace")

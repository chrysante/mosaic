    MOSAIC_INPUT_KEY_SYMBOL(hash,               "Hash")
    MOSAIC_INPUT_KEY_SYMBOL(angle_bracket_open, "Angle Bracket Open")
#undef MOSAIC_INPUT_KEY_SYMBOL

